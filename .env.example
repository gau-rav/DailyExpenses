AUTH_PORT=8787
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=penny_expenses
# Google OAuth (leave blank to hide the Google button on the sign-in screen).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
# Gmail OAuth (required for direct Gmail sync).
# Use a dedicated OAuth client, or copy the same client values here to keep Google sign-in off.
GOOGLE_GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=your-gmail-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8787/api/integrations/gmail/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=your-base64-32-byte-key
GMAIL_SYNC_SECRET=your-random-sync-secret
GMAIL_INITIAL_LOOKBACK_DAYS=7
# Optional: override the Gmail search query used for bank alerts.
# GMAIL_QUERY=newer_than:2d (debited OR spent OR "transaction alert")
# Optional: migrate an existing demo account to password-hash authentication.
# AUTH_DUMMY_EMAIL=your-existing-demo@email.com
# AUTH_DUMMY_PASSWORD=your-existing-demo-password
